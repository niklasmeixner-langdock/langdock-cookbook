# Required: workspace API key with the ASSISTANT_API scope
LANGDOCK_API_KEY=sk-...

# Required: agent UUID (share the API key with this agent)
LANGDOCK_AGENT_ID=00000000-0000-0000-0000-000000000000

# Optional: Langdock API host
# Cloud: https://api.langdock.com (default)
# Dedicated / local: https://your-host.example.com or http://127.0.0.1:3000
# LANGDOCK_API_BASE=https://api.langdock.com

# Optional: CSP frame-ancestors allow list (comma-separated). Default is *
# ALLOWED_ORIGINS=https://yourtenant.sharepoint.com

# Optional: fallback widget title if GET /agent fails
# WIDGET_TITLE=Assistant

# Optional: listen port (default 3333)
# PORT=3333
